<?xml version="1.0" encoding="utf-8"?>
<!-- 收藏页预览模式条目：缩略图 + 左上角国家 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/black"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="130dp">

        <!-- 快照缩略图（图片流） -->
        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/title_player"
            android:scaleType="centerCrop"
            tools:src="@color/item_bg" />

        <!-- 视频流占位（深色底 + 播放图标） -->
        <LinearLayout
            android:id="@+id/ivPlayPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#222222"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/btn_play"
                android:src="@drawable/ic_play" />
        </LinearLayout>

        <!-- 左上角：国家 -->
        <LinearLayout
            android:id="@+id/overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_preview_overlay"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="3dp"
            android:paddingEnd="6dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPreviewCountry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="意大利" />
        </LinearLayout>
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
