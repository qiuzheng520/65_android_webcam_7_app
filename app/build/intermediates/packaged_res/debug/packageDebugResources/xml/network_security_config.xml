<?xml version="1.0" encoding="utf-8"?>
<!-- 允许 http 明文流量，同时兼容系统默认安全策略（Android 10 ~ 14） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
